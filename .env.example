# Elasticsearch配置
ES_HOST=localhost
ES_PORT=9200
ES_TIMEOUT=30
ES_RETRY_MAX_ATTEMPTS=5
ES_RETRY_INITIAL_WAIT=1.0
ES_RETRY_MAX_WAIT=30.0

# Qdrant配置
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_TIMEOUT=30
QDRANT_RETRY_MAX_ATTEMPTS=5
QDRANT_RETRY_INITIAL_WAIT=1.0

# Redis配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_TIMEOUT=10

# 语料库处理配置
CHUNK_SIZE=300
CHUNK_OVERLAP_RATIO=0.2
GUWEN_PUNCTUATION_MODEL=GuwenBERT/guwen-punc
GUWEN_NER_MODEL=GuwenBERT/guwen-ner
CLASSICAL_TRANSLATOR_MODEL=Xunzi-LLM-of-Chinese-classics/XunziChat
BGE_M3_EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_BATCH_SIZE=32
EMBEDDING_GPU_ID=0
MAX_WORKERS=4

# Deep Search配置
LLM_BACKEND=local
LLM_MODEL_NAME=Qwen/Qwen2.5-7B-Instruct
LLM_LOCAL_ENDPOINT=http://localhost:8000/v1
LLM_API_KEY=
LLM_TIMEOUT=120
LLM_TEMPERATURE=0.3
LLM_TOP_P=0.9
MAX_CONTEXT_WINDOW=8192
ROLLING_SUMMARY_TARGET_LENGTH=500
MAX_ROUNDS=15
MAX_TIMEOUT_SECONDS=1800
FACTS_PER_BATCH=15
RETRIEVAL_TOP_K=10
HYBRID_SEARCH_ALPHA=0.5
CONCURRENT_QUERIES=3

# 日志配置
LOG_LEVEL=INFO
